{
  "name": "product-manage-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.js --dev",
    "build:web": "npm run build --prefix web",
    "start": "npm run build:web && node server.js",
    "dev:worker": "scripts\\with-node.cmd wrangler dev",
    "preview": "scripts\\with-node.cmd npm run build:web && wrangler preview",
    "deploy": "scripts\\with-node.cmd npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.18.0"
  },
  "devDependencies": {
    "vite": "^7.1.5",
    "wrangler": "^4.86.0"
  }
}
